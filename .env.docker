# ─────────────────────────────────────────────────────────────────
# .env.docker — Template environment untuk Docker deployment
# Salin file ini menjadi .env lalu isi nilainya
# cp .env.docker .env
# ─────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────
DB_ROOT_PASSWORD=ganti_password_root_mysql
DB_PASSWORD=ganti_password_user_dprd

# ── Aplikasi ──────────────────────────────────────────────────────
APP_BASE_URL=http://localhost/
APP_CSP_ENABLED=true

# Security headers. Change APP_BASE_URL to https:// in production.
SECURITY_HSTS_ENABLED=true
SECURITY_HSTS_MAX_AGE=31536000
SECURITY_HSTS_INCLUDE_SUBDOMAINS=false
SECURITY_HSTS_PRELOAD=false
# Enable only if HTTPS terminates at a trusted reverse proxy/load balancer.
SECURITY_TRUST_FORWARDED_PROTO=false

# Proteksi login admin tanpa CAPTCHA.
ADMIN_LOGIN_MAX_ATTEMPTS_PER_IP=10
ADMIN_LOGIN_IP_WINDOW_SECONDS=60
ADMIN_LOGIN_MAX_ATTEMPTS_PER_USERNAME=5
ADMIN_LOGIN_USERNAME_WINDOW_SECONDS=900
ADMIN_LOGIN_MAX_ATTEMPTS_GLOBAL=100
ADMIN_LOGIN_GLOBAL_WINDOW_SECONDS=600

# ── BMKG ──────────────────────────────────────────────────────────
BMKG_ADM4=72.71.01.1004

# OTP WhatsApp anggota. Jangan commit kredensial produksi.
OTP_PROVIDER=fazpass
FAZPASS_API_URL=https://api.fazpass.com
FAZPASS_API_PREFIX=/v1
FAZPASS_MERCHANT_KEY=
FAZPASS_GATEWAY_KEY=
FAZPASS_CALLBACK_SECRET=
FAZPASS_TIMEOUT_SECONDS=15
OTP_TTL_SECONDS=300
OTP_CHALLENGE_TTL_SECONDS=900
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_REQUEST_WINDOW_SECONDS=3600
OTP_MAX_REQUESTS_PER_PHONE=5
# Cukup untuk sekitar 40 anggota di balik satu IP/NAT beserta retry wajar.
OTP_MAX_REQUESTS_PER_IP=100
OTP_DAILY_WINDOW_SECONDS=86400
OTP_MAX_REQUESTS_PER_ACCOUNT_PER_DAY=10
# Circuit breaker biaya/provider untuk seluruh akun.
OTP_GLOBAL_WINDOW_SECONDS=3600
OTP_MAX_REQUESTS_GLOBAL=100
OTP_MAX_REQUESTS_GLOBAL_PER_DAY=300
OTP_MAX_VERIFICATION_ATTEMPTS=5
