# ─────────────────────────────────────────────────────────────────
# .env.docker — Template environment untuk Docker deployment
# Salin file ini menjadi .env lalu isi nilainya
# cp .env.docker .env
# ─────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────
DB_ROOT_PASSWORD=ganti_password_root_mysql
DB_PASSWORD=ganti_password_user_dprd

# ── Aplikasi ──────────────────────────────────────────────────────
APP_BASE_URL=http://localhost/

# ── BMKG ──────────────────────────────────────────────────────────
BMKG_ADM4=72.71.01.1004

# ── WhatsApp Notification (Fonnte) ───────────────────────────────
